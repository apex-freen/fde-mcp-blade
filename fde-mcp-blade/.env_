# ================================================================
# .env_ —— 环境变量模板
#
# 用法（两种任选）：
#   A) 一键安装脚本：./install.sh   —— 自动生成下面三个密钥并写成 .env，无需手改本文件
#   B) 手工方式：cp .env_ .env，然后至少填好 JWT_SECRET，再 docker compose up -d
# ================================================================

# ================================================
# 【必填】JWT 签名密钥
#   生成：openssl rand -base64 32
#   留空 = 容器启动即退出（安全设计：避免用公开已知密钥签发令牌）
# ================================================
JWT_SECRET="your-super-secret-key-that-is-at-least-32-bytes-long"
JWT_ISSUER="fde-mcp-blade"
JWT_EXPIRATION_HOURS=72

# ================================================
# 本机地址 = 令牌里本地 MCP 地址的主机部分
#   （http://<本机地址>:<端口>/mcp 会写进令牌与二维码，扫码的客户端需能访问该地址）
#   一键安装：install.sh 会探测默认路由出口 IP，确认后写在这里
#   手工部署：填内网 IP 或主机名；留空则退回运行 compose 时的 HOSTNAME
#   改完执行：docker compose up -d
#   ⚠️ 已生成的令牌里是旧地址，改完需重新生成令牌
# ================================================
HOST_HOSTNAME=""

# ================================================
# 内置 MariaDB（快速部署模式）
#   留空则使用 compose 里的兜底口令，仅供本地试用；生产请改成随机值
#   改法一：直接改这里
#   改法二：部署后执行 bash ops.sh init（自动生成随机口令并重建容器）
# ================================================
MARIADB_ROOT_PASSWORD="your-root-password"
MARIADB_PASSWORD="your-gis-remote-password"
MARIADB_DATABASE="apex_db"
MARIADB_USER="apex_remote"

# ================================================
# 镜像来源（install.sh 的「镜像来源」选项会自动写入下面两行）
#   国内：COMPOSE_FILE="docker-compose.yml"      镜像来自阿里云 ACR，PyPI 走阿里云
#   国外：COMPOSE_FILE="docker-compose_en.yml"   镜像来自 Docker Hub，PyPI 走官方
#   说明：compose 命令会自动读取本文件，所以 install.sh -u / ops.sh / 手工
#         docker compose 都会沿用这里选定的来源；改完执行：
#         docker compose pull && docker compose up -d
# ================================================
COMPOSE_FILE="docker-compose.yml"
PIP_INDEX_URL="https://mirrors.aliyun.com/pypi/simple/"

# ================================================
# 服务器配置
#   Web 管理台 / 业务接口 / MCP 端点 / 健康检查 共用该端口
# ================================================
SERVER_PORT=8018

# ================================================
# 日志
# ================================================
RUST_LOG=info

# ================================================
# 外部数据库模式（可选，用了就把下面这行的注释去掉并改成你的地址）
#   格式: mysql://用户名:密码@主机:端口/数据库名
#   首次启动时应用会自动建表，无需手工导入 SQL
# ================================================
# DATABASE_URL="mysql://user:password@your-database-host:3306/apex_db"

# ================================================
# 默认管理员账号：admin / admin123
#   ⚠️ 首次登录后请立即修改密码
# ================================================
