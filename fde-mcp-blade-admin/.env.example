# ============================================================
# 环境变量模板
# 用法：复制为 .env.development / .env.test / .env.production 后按需修改
#      （.env.* 已在 .gitignore 中，不会提交）
# ============================================================

# 浏览器标签页标题
VITE_APP_TITLE=智能体工具中枢

# 前端请求前缀（同时用于 vite 代理匹配，须与 vite.config.js 的 proxy key 一致）
VITE_API_BASE_URL=/prod-api

# 【仅开发环境】vite dev server 的代理目标（必须是可达的后端地址）
# 缺省时回退为 http://127.0.0.1:80
VITE_API_TARGET=http://127.0.0.1:8080

# 云端平台 API 地址
VITE_CLOUD_BASE_URL=https://api.agent-plat.com

# 是否启用 mock 数据
VITE_USE_MOCK=false
